---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import PageLayout from "@layouts/PageLayout.astro";

const title = "Page not found";
const description = "The page you are looking for does not exist.";
---

<PageLayout title={title} description={description}>
  <Container>
    <section class="animate flex min-h-[42vh] flex-col justify-center">
      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <h1 class="text-2xl font-semibold text-black dark:text-white">{title}</h1>
          <p class="max-w-lg font-serif leading-7">
            This page is not here anymore, or perhaps it never was.
          </p>
        </div>

        <div class="flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:gap-6">
          <Link href="/" underline={false} class="group inline-flex items-center gap-2 font-semibold text-black dark:text-white">
            <span class="size-1.5 rounded-full bg-accent"></span>
            <span class="underline decoration-black/15 underline-offset-4 transition-colors duration-300 group-hover:decoration-black/25 dark:decoration-white/30 dark:group-hover:decoration-white/50">
              Back home
            </span>
          </Link>
          <Link href="/blog" underline={false} class="group inline-flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-black/20 transition-colors duration-300 group-hover:bg-accent dark:bg-white/25"></span>
            <span class="underline decoration-black/15 underline-offset-4 transition-colors duration-300 group-hover:text-black group-hover:decoration-black/25 dark:decoration-white/30 dark:group-hover:text-white dark:group-hover:decoration-white/50">
              Read the blog
            </span>
          </Link>
        </div>
      </div>
    </section>
  </Container>
</PageLayout>
