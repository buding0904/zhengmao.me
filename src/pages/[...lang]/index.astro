---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import ConnectSection from "@components/ConnectSection.astro";
import { contentLang } from "@lib/utils";
import { SITE, HOME } from "@consts";
import { useTranslations, langBase, getLangStaticPaths, getBioLines } from "@i18n";
import type { Lang } from "@i18n";

export function getStaticPaths() {
  return getLangStaticPaths();
}

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = langBase(lang);
const bioLines = getBioLines(lang);

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft && contentLang(post) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const notes = (await getCollection("notes"))
  .filter(note => !note.data.draft && contentLang(note) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_NOTES_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(p => !p.data.draft && contentLang(p) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      {t("home.greeting")} <span class="text-xl">👋🏻</span>
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          {bioLines.map(line => (
            <p class="animate">{line}</p>
          ))}
        </article>
      </section>

      {blog.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h5 class="font-semibold text-black dark:text-white">
              {t("home.latestPosts")}
            </h5>
            <Link href={`${base}/blog`}>{t("home.seeAllPosts")}</Link>
          </div>
          <ul class="flex flex-col gap-4">
            {blog.map(post => (
              <li><ArrowCard entry={post} lang={lang} /></li>
            ))}
          </ul>
        </section>
      )}

      {notes.length > 0 && (
        <section class="animate space-y-6">
          <div class="flex flex-wrap gap-y-2 items-center justify-between">
            <h5 class="font-semibold text-black dark:text-white">
              {t("home.latestNotes")}
            </h5>
            <Link href={`${base}/notes`}>{t("home.seeAllNotes")}</Link>
          </div>
          <ul class="flex flex-col gap-4">
            {notes.map(note => (
              <li><ArrowCard entry={note} lang={lang} /></li>
            ))}
          </ul>
        </section>
      )}

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            {t("home.recentProjects")}
          </h5>
          <Link href={`${base}/projects`}>{t("home.seeAllProjects")}</Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li><ArrowCard entry={project} lang={lang} /></li>
          ))}
        </ul>
      </section>

      <ConnectSection lang={lang} />
    </div>
  </Container>
</PageLayout>
