---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { contentAssetBase, contentLang, contentSlug, readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import { LANGUAGES, useTranslations, langBase } from "@i18n";
import type { Lang } from "@i18n";

export async function getStaticPaths() {
  const projects = (await getCollection("projects"))
    .filter(p => !p.data.draft);

  return Object.keys(LANGUAGES).flatMap((lang) =>
    projects
      .filter(p => contentLang(p) === lang)
      .map((project) => ({
        params: {
          lang: lang === "en" ? undefined : lang,
          slug: contentSlug(project),
        },
        props: { project, lang: lang as Lang },
      }))
  );
}

type Props = { project: CollectionEntry<"projects">; lang: Lang };
const { project, lang } = Astro.props;
const { Content } = await project.render();
const t = useTranslations(lang);
const base = langBase(lang);
---

<PageLayout title={project.data.title} description={project.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href={`${base}/projects`}>
        {t("projects.backToProjects")}
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={project.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(project.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {project.data.title}
      </div>
      {(project.data.demoURL || project.data.repoURL) && (
        <nav class="animate flex gap-1">
          {project.data.demoURL && (
            <Link href={project.data.demoURL} external>
              {t("projects.demo")}
            </Link>
          )}
          {project.data.demoURL && project.data.repoURL && <span>/</span>}
          {project.data.repoURL && (
            <Link href={project.data.repoURL} external>
              {t("projects.repo")}
            </Link>
          )}
        </nav>
      )}
    </div>
    <article class="animate" data-content-assets={contentAssetBase(project)}>
      <Content />
    </article>
  </Container>
</PageLayout>
