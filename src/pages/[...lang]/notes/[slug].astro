---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrev from "@components/BackToPrev.astro";
import { contentAssetBase, contentLang, contentSlug, readingTime } from "@lib/utils";
import { LANGUAGES, useTranslations, langBase } from "@i18n";
import type { Lang } from "@i18n";

export async function getStaticPaths() {
  const notes = (await getCollection("notes"))
    .filter(note => !note.data.draft);

  return Object.keys(LANGUAGES).flatMap((lang) =>
    notes
      .filter(note => contentLang(note) === lang)
      .map((note) => ({
        params: {
          lang: lang === "en" ? undefined : lang,
          slug: contentSlug(note),
        },
        props: { note, lang: lang as Lang },
      }))
  );
}

type Props = { note: CollectionEntry<"notes">; lang: Lang };
const { note, lang } = Astro.props;
const { Content } = await note.render();
const t = useTranslations(lang);
const base = langBase(lang);
---

<PageLayout title={note.data.title} description={note.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href={`${base}/notes`}>
        {t("notes.backToNotes")}
      </BackToPrev>
    </div>
    <div class="space-y-1 mt-10 mb-4">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={note.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(note.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {note.data.title}
      </div>
    </div>
    <article class="animate" data-content-assets={contentAssetBase(note)}>
      <Content />
    </article>
  </Container>
</PageLayout>
