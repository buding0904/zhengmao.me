---
import type { CollectionEntry } from "astro:content";
import { langBase } from "@i18n";
import type { Lang } from "@i18n";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
  lang?: Lang;
};

const { entry, lang = "en" } = Astro.props;
const base = langBase(lang);
const slug = "canonicalSlug" in entry.data && entry.data.canonicalSlug
  ? entry.data.canonicalSlug
  : entry.slug;
---

<a href={`${base}/${entry.collection}/${slug}`} class="relative group block rounded-lg pr-4 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out">
  <div class="flex min-w-0 flex-col">
    <div class="font-semibold text-black dark:text-white">
      {entry.data.title}
    </div>
    <div class="text-sm break-words">
      {entry.data.description}
    </div>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute top-1/2 right-0 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current">
    <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
    <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
  </svg>
</a>
